# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER, SECURITY & HOSTING
# ==============================================================================
# NODE_ENV=production in hosted environments
NODE_ENV="development"
# Port used by Express/Vite server (hosting platforms usually inject PORT)
PORT="3000"
# Comma-separated origins allowed for browser API access (recommended in production)
CORS_ORIGIN="http://localhost:3000"
# API auth: disabled by default in development; enabled automatically in production.
# Set ENABLE_API_AUTH=true to enforce auth in development, or DISABLE_API_AUTH=true to disable.
# ENABLE_API_AUTH="true"
# DISABLE_API_AUTH="false"
# Max request body size for JSON APIs
JSON_LIMIT="10mb"

# ==============================================================================
# SUPABASE / VERCEL & POSTGRESQL CONFIGURATION
# ==============================================================================
# Supabase Public API credentials for client-side connection
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database Connection string for Vercel / Supabase PostgreSQL (Neon, Supabase, RDS)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# SQL Host & Credentials for Cloud SQL / Supabase / Neon
SQL_HOST="db.your-project.supabase.co"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="your-secure-password"
